# Copia este archivo como .env (cp .env.example .env) y cambia los valores. NO subas .env a Git.

# PostgreSQL (el mismo usuario/clave para las 3 bases)
DB_USER=postgres
DB_PASSWORD=cambia_esta_clave

# JWT: auth-service firma y order-service verifica con ESTE mismo secreto (mínimo 32 caracteres)
JWT_SECRET=cambia-este-secreto-por-uno-largo-de-32-o-mas-caracteres
JWT_EXPIRATION_MINUTES=120

# Clave compartida entre order-service y product-service para descontar/aumentar stock
INTERNAL_API_KEY=cambia-esta-clave-interna

# Cuenta administrador que crea auth-service al iniciar
ADMIN_EMAIL=admin@admin.cl
ADMIN_PASSWORD=Gasvolcan26

# Cuenta vendedor (solo ve productos y órdenes) que crea auth-service al iniciar
VENDEDOR_EMAIL=vendedor@volcan.cl
VENDEDOR_PASSWORD=Vendedor26

# Origen del frontend permitido por CORS (varios separados por coma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
